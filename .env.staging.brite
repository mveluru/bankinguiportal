# STAGING environment template. Copy to .env.staging ON THE STAGING HOST (never commit the real file), fill in every
# CHANGE_ME, and lock it down:  chmod 600 .env.staging
#
# How it is used (Next.js only auto-loads .env, .env.local and .env.production, NOT this file, so load it yourself):
#   Build (NEXT_PUBLIC_* are baked into the browser bundle here):  set -a; . ./.env.staging; set +a; npm run build
#   Run (systemd):  EnvironmentFile=/etc/bankinguiportal-staging.env     Run (shell):  set -a; . ./.env.staging; set +a; npm start
# Wrap any value that contains spaces in double quotes. Avoid $, # and quotes inside values (passwords too) so the
# same file works for both the shell and systemd.
# Staging is a production-mode build (NODE_ENV=production): the session cookie is Secure, so staging needs HTTPS too.
# Full steps: .claude/docs/production_deploy.md

NODE_ENV=production
PORT=3000

# --- Banking backend (STAGING instance: never point staging at production data) -----------------------------------
# Used by the browser for /bff/** calls. Read at BUILD time; must be reachable from users' browsers, and the backend's
# banking.portal.allowed-origins must include this portal's origin (e.g. https://portal-staging.example.com).
NEXT_PUBLIC_API_BASE_URL=https://bank-staging.example.com/brite
# Path prefix of the backend BFF endpoints (default /bff/v1/portal). Read at BUILD time.
NEXT_PUBLIC_BFF_PORTAL_PATH=/bff/v1/portal
# Used by the Next server to forward /api/banking/* (withdraw, deposit, statement, close). Read at START time; can be an
# internal address.
BANKING_BACKEND_URL=http://banking-staging.internal:8081/brite
# Sent as X-Customer-Id before sign-in (rate-limit key only, not authentication). Read at BUILD time.
NEXT_PUBLIC_CUSTOMER_ID=portal-staging

# --- Authentication (front-end-only demo; not real security) --------------------------------------------------------
# REQUIRED. Signs session cookies and derives the key that encrypts 2FA secrets. Generate: openssl rand -base64 48
# Use a DIFFERENT value from production. Changing it signs everyone out and disables existing 2FA setups.
AUTH_SECRET=CHANGE_ME_long_random_string_unique_to_staging
# username:password:customerId[:admin], comma separated. Test accounts only; do not reuse production passwords.
DEMO_USERS=Admin:CHANGE_ME_staging_admin_pw:CUST-ADMIN:admin,tester:CHANGE_ME_staging_tester_pw:CUST-TESTER

# --- Sessions (seconds) ---------------------------------------------------------------------------------------------
SESSION_MAX_AGE_SECONDS=28800
REMEMBER_ME_MAX_AGE_SECONDS=2592000
# Seconds before expiry that the "stay signed in" countdown appears. Read at BUILD time.
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120

# --- Lockout --------------------------------------------------------------------------------------------------------
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Audit log: rotate past this many bytes (.data/audit.log -> audit.log.1) ----------------------------------------
AUDIT_MAX_BYTES=1048576

# --- Help and legal pages -------------------------------------------------------------------------------------------
SUPPORT_EMAIL=support-staging@example.com
LEGAL_ENTITY_NAME="Brite Banking (Staging)"
# Leave unset in staging so the "template, not legal advice" notice stays visible.
# LEGAL_REVIEWED=true
# LEGAL_GOVERNING_LAW="the State of Texas"
