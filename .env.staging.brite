# STAGING environment template. Copy to .env.staging ON THE STAGING HOST (never commit the real file), fill in every
# CHANGE_ME, and lock it down:  chmod 600 .env.staging
#
# How it is used (Next.js only auto-loads .env, .env.local and .env.production, NOT this file, so load it yourself):
#   Build (NEXT_PUBLIC_* are baked into the browser bundle here):  set -a; . ./.env.staging; set +a; npm run build
#   Run (systemd):  EnvironmentFile=/etc/bankinguiportal-staging.env     Run (shell):  set -a; . ./.env.staging; set +a; npm start
# Wrap any value that contains spaces in double quotes. Avoid $, # and quotes inside values (passwords too) so the
# same file works for both the shell and systemd.
# Staging is a production-mode build (NODE_ENV=production): the sign-in cookies are Secure, so staging needs HTTPS too.
# Full steps: .claude/docs/production_deploy.md

NODE_ENV=production
PORT=3000

# --- Banking backend (STAGING instance: never point staging at production data) -----------------------------------
# Used by the Next server only (the browser never calls the backend). Read at START time; can be an internal address.
# Customers and employees sign in against this backend, which issues the tokens; the portal keeps no users of its own.
BANKING_BACKEND_URL=http://banking-staging.internal:8081/brite
BFF_PORTAL_PATH=/bff/v1/portal
BFF_STAFF_PATH=/bff/v1/staff

# --- Sessions (seconds) ---------------------------------------------------------------------------------------------
# The token lifetime is set by the backend (banking.jwt.expiration-minutes). These only control the warning and idle logout.
# Seconds before the token expires that the countdown appears, and idle seconds before sign-out. Read at BUILD time.
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120
NEXT_PUBLIC_IDLE_TIMEOUT_SECONDS=120

# --- Help and legal pages -------------------------------------------------------------------------------------------
SUPPORT_EMAIL=support-staging@example.com
LEGAL_ENTITY_NAME="Brite Banking (Staging)"
# Leave unset in staging so the "template, not legal advice" notice stays visible.
# LEGAL_REVIEWED=true
# LEGAL_GOVERNING_LAW="the State of Texas"
