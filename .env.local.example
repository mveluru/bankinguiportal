# Spring Boot banking service (context-path /brite, port 8081). Must be listed in banking.portal.allowed-origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/brite
# Sent as X-Customer-Id (rate-limit key only, not authentication)
NEXT_PUBLIC_CUSTOMER_ID=demo-customer
# Server-side only: Next proxies /api/banking/* here (withdraw/deposit are not CORS-enabled on the backend)
BANKING_BACKEND_URL=http://localhost:8081/brite
# Demo login (front end only, NOT real security). Format: username:password:customerId, comma separated.
DEMO_USERS=demo:demo1234:CUST-DEMO,alice:alice1234:CUST-ALICE
# Secret used to sign the session cookie. Required in production; a dev default is used otherwise.
AUTH_SECRET=change-me-to-a-long-random-string
# Session length in seconds (default 28800 = 8h) and how long before expiry the timeout warning appears (default 120).
SESSION_MAX_AGE_SECONDS=28800
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120
# Length of a "remember me" session in seconds (default 2592000 = 30 days). Unchecked sessions use SESSION_MAX_AGE_SECONDS.
REMEMBER_ME_MAX_AGE_SECONDS=2592000
