# PRODUCTION environment template. Copy to .env.prod ON THE PRODUCTION HOST (never commit the real file), fill in every
# CHANGE_ME, and lock it down:  chmod 600 .env.prod
#
# How it is used (Next.js only auto-loads .env, .env.local and .env.production, NOT this file, so load it yourself):
#   Build (NEXT_PUBLIC_* are baked into the browser bundle here):  set -a; . ./.env.prod; set +a; npm run build
#   Run (systemd):  EnvironmentFile=/etc/bankinguiportal.env          Run (shell):  set -a; . ./.env.prod; set +a; npm start
# Wrap any value that contains spaces in double quotes. Avoid $, # and quotes inside values (passwords too) so the
# same file works for both the shell and systemd.
# Serve ONLY over HTTPS: the session cookie is Secure, so over plain HTTP sign-in appears to loop.
# Promotion: build a release for staging, verify it there, then build the same commit again with THESE values
# (NEXT_PUBLIC_* differ per environment, so the browser bundle cannot simply be copied from staging).
# Full steps: .claude/docs/production_deploy.md

NODE_ENV=production
PORT=3000

# --- Banking backend (PRODUCTION) -----------------------------------------------------------------------------------
# Used by the browser for /bff/** calls. Read at BUILD time; the backend's banking.portal.allowed-origins must include
# this portal's origin. The backend does not authenticate requests: keep it off the open internet.
NEXT_PUBLIC_API_BASE_URL=https://bank.example.com/brite
# Path prefix of the backend BFF endpoints (default /bff/v1/portal). Read at BUILD time.
NEXT_PUBLIC_BFF_PORTAL_PATH=/bff/v1/portal
# Used by the Next server to forward /api/banking/* (withdraw, deposit, statement, close). Read at START time.
BANKING_BACKEND_URL=http://banking.internal:8081/brite
# Sent as X-Customer-Id before sign-in (rate-limit key only, not authentication). Read at BUILD time.
NEXT_PUBLIC_CUSTOMER_ID=portal

# --- Authentication (front-end-only demo; not real security) --------------------------------------------------------
# REQUIRED; the server refuses to start in production without it. Signs session cookies and derives the key that encrypts
# 2FA secrets. Generate: openssl rand -base64 48. Must differ from staging. Changing it signs everyone out and disables
# existing 2FA setups, and it must be identical on every instance.
AUTH_SECRET=CHANGE_ME_long_random_string_unique_to_production
# username:password:customerId[:admin], comma separated. Replace every default: the demo passwords are public.
DEMO_USERS=Admin:CHANGE_ME_strong_unique_password:CUST-ADMIN:admin

# --- Sessions (seconds) ---------------------------------------------------------------------------------------------
# Production is stricter than staging: shorter sessions, shorter "remember me".
SESSION_MAX_AGE_SECONDS=1800
REMEMBER_ME_MAX_AGE_SECONDS=604800
# Seconds before expiry that the "stay signed in" countdown appears. Read at BUILD time.
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120

# --- Lockout --------------------------------------------------------------------------------------------------------
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Audit log: rotate past this many bytes (.data/audit.log -> audit.log.1) ----------------------------------------
AUDIT_MAX_BYTES=10485760

# --- Help and legal pages -------------------------------------------------------------------------------------------
SUPPORT_EMAIL=support@example.com
LEGAL_ENTITY_NAME="Brite Banking"
LEGAL_GOVERNING_LAW="the State of Texas"
# Set to true ONLY after a lawyer has reviewed the wording in lib/legal.ts; it hides the "template" notice.
LEGAL_REVIEWED=false
