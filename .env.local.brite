# Spring Boot banking service (context-path /brite, port 8081). Must be listed in banking.portal.allowed-origins.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/brite
# Sent as X-Customer-Id (rate-limit key only, not authentication)
NEXT_PUBLIC_CUSTOMER_ID=demo-customer
# Server-side only: Next proxies /api/banking/* here (no longer used by any screen; all calls go to /bff/**)
BANKING_BACKEND_URL=http://localhost:8081/brite
# Demo login (front end only, NOT real security). Format: username:password:customerId[:admin], comma separated.
# A fourth field of "admin" grants access to /admin/users.
DEMO_USERS=demo:demo1234:CUST-DEMO,alice:alice1234:CUST-ALICE,Admin:admin1234:CUST-ADMIN:admin
# Secret used to sign the session cookie. Required in production; a dev default is used otherwise.
AUTH_SECRET=change-me-to-a-long-random-string
# Session length in seconds (default 28800 = 8h) and how long before expiry the timeout warning appears (default 120).
SESSION_MAX_AGE_SECONDS=28800
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120
# Length of a "remember me" session in seconds (default 2592000 = 30 days). Unchecked sessions use SESSION_MAX_AGE_SECONDS.
REMEMBER_ME_MAX_AGE_SECONDS=2592000
# Account lockout: failed password attempts before a username is locked, and how long the lock lasts (defaults 5 / 15).
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Optional: contact address shown in Help & FAQ ("How do I contact support?"). Unset = "contact an administrator".
# SUPPORT_EMAIL=support@example.com
# Legal pages (/terms, /privacy). Entity name shown in the text (default "Brite Banking"); optional governing-law clause;
# set LEGAL_REVIEWED=true once a lawyer has reviewed the wording to hide the "template" notice.
# LEGAL_ENTITY_NAME=Brite Banking
# LEGAL_GOVERNING_LAW=the State of Texas
# LEGAL_REVIEWED=true
