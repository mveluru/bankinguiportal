# Spring Boot banking service (context-path /brite, port 8081). Server-side only: the browser never calls it, the
# Next route handlers in app/api/* do, adding the signed-in user's Bearer token. Read at START time.
BANKING_BACKEND_URL=http://localhost:8081/brite
# Path prefixes of the backend BFF endpoints (defaults shown): customer portal and staff portal.
BFF_PORTAL_PATH=/bff/v1/portal
BFF_STAFF_PATH=/bff/v1/staff
# How long before the backend token expires the timeout warning appears (default 120). The token lifetime itself is set by
# the backend (banking.jwt.expiration-minutes). Read at BUILD time.
NEXT_PUBLIC_SESSION_WARNING_SECONDS=120
# Sign out after this many seconds without activity (default 120). Read at BUILD time.
NEXT_PUBLIC_IDLE_TIMEOUT_SECONDS=120
# Optional: contact address shown in Help & FAQ ("How do I contact support?"). Unset = "contact an administrator".
# SUPPORT_EMAIL=support@example.com
# Legal pages (/terms, /privacy). Entity name shown in the text (default "Brite Banking"); optional governing-law clause;
# set LEGAL_REVIEWED=true once a lawyer has reviewed the wording to hide the "template" notice.
# LEGAL_ENTITY_NAME=Brite Banking
# LEGAL_GOVERNING_LAW=the State of Texas
# LEGAL_REVIEWED=true
